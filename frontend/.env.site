# Build settings for the static site at refgenie.org (`npm run build:site`).
# The SPA is served by Cloudflare; its data comes from the API host.
VITE_SERVICE_INFO_URL=https://api.refgenie.org/service-info
VITE_API_BASE=https://api.refgenie.org/v4
# In-browser FASTA download, extract and compare on the genome page.
VITE_FASTA_DOWNLOAD=1
