    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "msw": "^2.7.0",
    "prettier": "^3.5.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.30.1",
    "vite": "^8",
    "vitest": "^4"
